    "Creates a branch at the current commit and switches to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt einen Branch am aktuellen Commit und wechselt dorthin."
          }
        }
      }
    },
    "Creates a new Typst project in a folder you choose and opens it in a new window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt ein neues Typst-Projekt in einem gewählten Ordner und öffnet es in einem neuen Fenster."
          }
        }
      }
    },
    "Creates a new file in the project and starts naming it in the sidebar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine neue Datei im Projekt und beginnt die Benennung in der Seitenleiste."
          }
        }
      }
    },
    "Creates a new folder in the project and starts naming it in the sidebar." : {
